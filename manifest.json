{
  "author": {
    "email": "manhgdev@gmail.com"
  },
  "name": "Grok Automation - Auto Grok on Grok.com",
  "description": "Auto Grok your prompts at scale. Batch generate and auto-download videos and images on grok.com.",
  "version": "1.0.56",
  "version_name": "1.0.56",
  "manifest_version": 3,
  "action": {
    "default_title": "Grok Automation",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content/content.js"
      ],
      "matches": [
        "*://grok.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "host_permissions": [
    "*://grok.com/*",
    "*://*.grok.com/*"
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "downloads",
    "scripting",
    "tabs",
    "windows",
    "cookies",
    "debugger"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://grok.com/*"
      ],
      "resources": [
        "content/upload-hook.js",
        "content/content.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
